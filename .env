# Django
DEBUG=1
SECRET_KEY=dev-secret
secret_key_platform=dev-secret
Platform_URL=hudhud.local
extra_platform_domains=
secured_platform=true
MANAGE_SSL_DIRECTLY=false

# Core service
CORE_URL=http://localhost:8000
ALTERNATIVE_CORE_URL=
INTERNAL_CORE_URL=
CORE_TOKEN=dev-core-token
CRON_TOKEN=dev-cron-token
DEFAULT_WEBSOCKET_TYPE=socketio
WEBSOCKET_URL=

# Superuser bootstrap (used by docker/entrypoint.sh)
DJANGO_SUPERUSER_EMAIL=admin@hudhud.ai
DJANGO_SUPERUSER_PASSWORD=admin123

# DB
DB_NAME=appdb
DB_USERNAME_PLATFORM=appuser
DB_PASSWORD_PLATFORM=apppass
DB_host=localhost
DB_PORT=5432

# Audit logging
AUDIT_LOG_SENSITIVE_FIELDS=password,token,secret,api_key,client_secret,access_token,refresh_token
AUDIT_TRACKED_MODELS=*
AUDIT_EXCLUDED_MODELS=common.AuditLog,common.DataChangeLog
AUDIT_SYSTEM_USER_EMAIL=system@hudhud.ai

# Login security
ALLOWED_SESSIONS_PER_USER=0
ALLOWED_LOGIN_ATTEMPTS=3
LOGIN_ATTEMPTS_TIME_WINDOW=10
PASSWORD_MIN_SMALL_LETTERS=1
PASSWORD_MIN_CAPITAL_LETTERS=1
PASSWORD_MIN_NUMBERS=1
PASSWORD_MIN_SPECIAL_CHARACTERS=1
SSO_ENABLED=False
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
OIDC_OP_AUTHORIZATION_ENDPOINT=
OIDC_OP_TOKEN_ENDPOINT=
OIDC_OP_USER_ENDPOINT=
OIDC_OP_JWKS_ENDPOINT=
OIDC_RP_SCOPES=

ENABLE_APM=True
APM_PROVIDER=OTEL
APM_SERVICE_NAME=platform
APM_ENVIRONMENT=local
APM_SERVICE_NAMESPACE=hudhud
APM_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
APM_OTEL_EXPORTER_OTLP_PROTOCOL=grpc
APM_OTEL_EXPORTER_OTLP_INSECURE=true
# Enable OTLP log export to Loki via collector
ENABLE_OTEL_LOGS_EXPORTER=true

EMAIL_TYPE=LOCAL_SMTP
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=no-reply@hudhud.local

AUTH_LOGIN_RATE_LIMIT_ATTEMPTS=3
AUTH_LOGIN_RATE_LIMIT_WINDOW_MINUTES=10AUTH_MAX_CONCURRENT_SESSIONS=5
AUTH_SESSION_DURATION_DEFAULT_HOURS=24
AUTH_LOGIN_RATE_LIMIT_WINDOW_MINUTES=10
AUTH_RATE_LIMIT_REFRESH=10/hour
REDIS_URL=redis://redis:6379/0

